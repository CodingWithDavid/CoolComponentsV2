@page "/carousel"

<PageTitle>Carousel - David's Cool Components v2</PageTitle>

<section class="page-hero">
    <div class="container">
        <div class="release-badge"><span class="status-dot"></span>Zero JavaScript Component</div>
        <h1>The Good Dogs <span>Carousel</span></h1>
        <p>A reusable Blazor component powered entirely by HTML radio inputs and CSS. Click the arrows or dots, or focus the carousel and use the arrow keys.</p>
    </div>
</section>

<section class="carousel-section">
    <div class="container">
        <CssCarousel Slides="DogSlides" Label="Dog photo gallery" />
    </div>
</section>

<section class="section-space carousel-details">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Under the Hood</p>
            <h2>Pure HTML &amp; CSS, Packaged for Blazor</h2>
        </div>
        <div class="features-grid">
            @foreach (var detail in Details)
            {
                <article class="feature-card">
                    <div class="feature-icon"><Icon Name="@detail.Icon" /></div>
                    <h3>@detail.Title</h3>
                    <p>@detail.Description</p>
                </article>
            }
        </div>

        <div class="photo-credits">
            <h2>Photo credits</h2>
            <p>Images from Wikimedia Commons featured pictures, resized for the web.</p>
            <ul>
                @foreach (var slide in DogSlides)
                {
                    <li>
                        <a href="@slide.SourceUrl" target="_blank" rel="noopener noreferrer">@slide.Title<span class="visually-hidden"> (opens in a new tab)</span></a>
                        by @slide.Credit, <a href="@LicenseUrl(slide.License)" target="_blank" rel="noopener noreferrer">@slide.License<span class="visually-hidden"> (opens in a new tab)</span></a>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

